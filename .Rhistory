temp_agre_final$City <- as.numeric(temp_agre_final$City)
lista_newData[[i]] <- temp_agre_final
i <- i + 1
rm(base, base_temp, temp_agre, temp_agre_final)
gc()  # devolve a RAM pro sistema
}
