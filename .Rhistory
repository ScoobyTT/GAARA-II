files_dbf <- list.files(path = mypath, pattern = "\\.dbf$")
files <- setdiff(
str_replace_all(files_dbc, "\\.dbc$", ""),
str_replace_all(files_dbf, "\\.dbf$", "")
)
cat("Arquivos pendentes de conversão:", length(files), "\n")
