drop_na()
}else{
temp_agre <- base_temp %>%
group_by(DT_NOTIFIC, SEM_NOT, Noti_Year, SG_UF_NOT, ID_MUNICIP, NU_IDADE_N, CS_SEXO, CS_RACA) %>%
